# ==============================================================================
# Regulatory OS - Maharashtra Geospatial & Regulatory Intelligence Stack
# ==============================================================================

# 1. Google Gemini AI Key (Optional - for AI Statutory Explanations)
# Deterministic spatial analysis works 100% offline without any API key.
# Get free key at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# 2. PostGIS / PostgreSQL Database Connection (Dockerized or Local)
# Initializes with authoritative Maharashtra boundaries: docker/init-db/02-maharashtra-jurisdictions.sql
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/regulatory_os

# 3. VROOM Open Routing Optimization Server (Optional - for Inspector Workspace)
VROOM_URL=http://localhost:3001

# No paid map APIs (OpenStreetMap, PostGIS EPSG:4326, and pure H3 Resolution 8 used)
